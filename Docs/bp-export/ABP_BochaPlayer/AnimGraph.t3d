               ShowPinForProperties(5)=(PropertyName="Method",PropertyFriendlyName="Method",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_BlendSpacePlayer:Method", "How this node will synchronize with other animations. Note that this determines how the output\nof this node is used for synchronization, not of animations contained by it."),CategoryName="Sync")
